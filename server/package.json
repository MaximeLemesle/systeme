{
  "name": "systeme-evolution-server",
  "version": "1.0.0",
  "description": "Backend du Système d'évolution (Express + Prisma + IA Ollama)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json src/index.js",
    "start": "node src/index.js",
    "pretest": "rm -f prisma/test.db && cat prisma/migrations/*/migration.sql | sqlite3 prisma/test.db",
    "test": "DATABASE_URL=file:./test.db NODE_ENV=test node --test --test-force-exit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.2.1",
    "supertest": "^7.2.2"
  }
}
