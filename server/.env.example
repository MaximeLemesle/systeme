# Base SQLite (fichier local, aucune infra à lancer)
DATABASE_URL="file:./dev.db"

# Secret de signature des JWT — change-le en prod
JWT_SECRET="change-me"

# IA locale via Ollama (aucune clé API requise)
OLLAMA_URL="http://localhost:11434"
# Modèle léger adapté à l'intake structuré.
OLLAMA_MODEL="llama3.2:3b"

PORT=4000
HOST="127.0.0.1"

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
