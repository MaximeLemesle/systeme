# Base SQLite (fichier local, aucune infra à lancer)
DATABASE_URL="file:./dev.db"

# Secret de signature des JWT — change-le en prod
JWT_SECRET="change-me"

# IA locale via Ollama (aucune clé API requise)
AI_PROVIDER="ollama"          # "ollama" | "mistral"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"

# Fallback cloud optionnel (laisser vide si AI_PROVIDER=ollama)
MISTRAL_API_KEY=""

PORT=4000
HOST="127.0.0.1"
