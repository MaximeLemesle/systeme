# Base SQLite (fichier local, aucune infra à lancer)
DATABASE_URL="file:./dev.db"

# Secret de signature des JWT — change-le en prod
JWT_SECRET="change-me"

# IA locale via Ollama (aucune clé API requise)
AI_PROVIDER="ollama"          # "ollama" | "mistral"
OLLAMA_URL="http://localhost:11434"
# llama3.2:3b = rapide (~15-30 s/réponse) ; "mistral" = plus qualitatif mais 4-6x plus lent
OLLAMA_MODEL="llama3.2:3b"

# Fallback cloud optionnel (laisser vide si AI_PROVIDER=ollama)
MISTRAL_API_KEY=""

PORT=4000
HOST="127.0.0.1"

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Compte admin créé par `npm run db:seed` (register ne crée jamais d'admin)
ADMIN_EMAIL="admin@coach.local"
ADMIN_PASSWORD="admin123!"
