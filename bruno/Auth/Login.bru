meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "maxime@example.com",
    "password": "secret123"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().token) {
    bru.setEnvVar("token", res.getBody().token);
  }
}
