meta {
  name: Creer un objectif
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/domaines/{{domaineId}}/objectifs
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Courir 10 km en moins de 50 minutes",
    "description": "Préparation progressive sur dix semaines",
    "rawInput": "Je veux courir 10 km en moins de 50 minutes",
    "metricLabel": "distance",
    "unit": "km",
    "targetValue": 10,
    "targetDistanceKm": 10,
    "targetTimeSeconds": 3000,
    "difficulty": "moyen",
    "niveau": "intermédiaire",
    "objectiveType": "chrono",
    "trainingFrequency": 3,
    "planWeeks": 10,
    "deadline": "2026-10-01",
    "aiRefined": true
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("objectifId", res.getBody().id);
  }
}
