meta {
  name: Raffiner un objectif
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ai/objectifs/refine
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "objectifBrut": "créer une app mobile dans 1 mois",
    "domaineId": {{domaineId}},
    "niveau": "débutant",
    "objectiveType": null
  }
}
